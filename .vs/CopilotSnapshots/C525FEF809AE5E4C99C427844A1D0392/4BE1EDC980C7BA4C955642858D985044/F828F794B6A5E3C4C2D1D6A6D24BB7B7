using Microsoft.Win32;
using System;
using System.Collections.Generic;
using System.Text;
using System.Windows;
using System.Windows.Controls;
using System.Windows.Data;
using System.Windows.Documents;
using System.Windows.Input;
using System.Windows.Media;
using System.Windows.Media.Imaging;
using System.Windows.Shapes;


namespace TCC2026LBP
{
    /// <summary>
    /// Lógica interna para ArquivosWindow.xaml
    /// </summary>
    public partial class ArquivosWindow : Window
    {
        private MainWindow main;
        int indiceGuia = 0;
        public ArquivosWindow(MainWindow janelaPrincipal)
        {
            InitializeComponent();
            main = janelaPrincipal;
        }
        public event Action<string> GuiaAdicionada;
        private void Button_Click_1(object sender, RoutedEventArgs e)
        {
            if (sender is Button btn)
            {
                switch (btn.Name)
                {
                    case "ButtonAbrir":
                        AbrirImagem();
                        this.Close();
                        break;
                    case "ButtonNovaGuia":
                        AdicionarGuia();
                        indiceGuia++;
                        this.Close();
                        break;
                    case "ButtonFechar":
                        main.FecharGuiaSelecionada();
                        this.Close();
                        break;
                    case "ButtonSair":
                        Application.Current.Shutdown();
                        break;
                    default:
                        break;
                }

            }
        }

        public void AbrirImagem()
        {
            OpenFileDialog dialog = new OpenFileDialog();

            dialog.Filter = "Imagens|*.jpg;*.jpeg;*.png;*.bmp";
            dialog.Title = "Selecione uma imagem";

            if (dialog.ShowDialog() == true)
            {
                main.MostrarImagem(dialog.FileName);

            }
        }
        public void AdicionarGuia()
        {
            
            string nomeGuia = $"Guia {indiceGuia}"; 

            GuiaAdicionada?.Invoke(nomeGuia);

            this.Close();

        }


    }
}
