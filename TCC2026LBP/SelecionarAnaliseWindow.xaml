<Window x:Class="TCC2026LBP.SelecionarAnaliseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Selecionar Análise" Height="400" Width="480"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ListBox x:Name="ListaAnalises" Grid.Row="0" DisplayMemberPath="Descricao" FontSize="14"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Carregar" Width="100" Height="30" Margin="0,0,10,0" Click="ButtonCarregar_Click"/>
            <Button Content="Excluir" Width="100" Height="30" Margin="0,0,10,0" Foreground="DarkRed" Click="ButtonExcluir_Click"/>
            <Button Content="Cancelar" Width="100" Height="30" Click="ButtonCancelar_Click"/>
        </StackPanel>
    </Grid>
</Window>