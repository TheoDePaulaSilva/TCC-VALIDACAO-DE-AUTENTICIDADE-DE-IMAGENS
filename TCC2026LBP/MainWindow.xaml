<Window x:Class="TCC2026LBP.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TCC2026LBP"
        mc:Ignorable="d"
        WindowState="Maximized"
        Title="TCC2026LBP — Detecção de Imagens" Height="600" Width="1000">

    <Window.Resources>
        <Style x:Key="BotaoMenu" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="20,14"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fundo" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fundo" Property="Background" Value="#1E88E5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <Border Grid.Row="0" Background="#42A5F5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="ButtonMenu" Grid.Column="0" Width="60" Height="60"
                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                        Click="ButtonMenu_Click">
                    <Viewbox Width="22" Height="22">
                        <Canvas Width="24" Height="24">
                            <Rectangle Width="24" Height="2.5" Canvas.Top="3" Fill="White"/>
                            <Rectangle Width="24" Height="2.5" Canvas.Top="10.75" Fill="White"/>
                            <Rectangle Width="24" Height="2.5" Canvas.Top="18.5" Fill="White"/>
                        </Canvas>
                    </Viewbox>
                </Button>

                <TextBlock Grid.Column="1" Text="Detecção de Imagens — TCC2026LBP"
                           Foreground="White" FontSize="18" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="10,0,0,0"/>
            </Grid>
        </Border>

        <!-- Corpo: menu lateral + conteúdo -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ColunaMenu" Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Menu lateral -->
            <Border x:Name="PainelMenu" Grid.Column="0" Background="#42A5F5" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Área rolável para as opções superiores -->
                        <RowDefinition Height="*"/>
                        <!-- Área fixa no rodapé para o botão Sair -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Opções superiores dentro do ScrollViewer -->
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,20,0,10">

                            <Button Style="{StaticResource BotaoMenu}" Click="ButtonAbrirImagem_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="20" Height="20" Margin="0,0,14,0">
                                        <Canvas Width="24" Height="24">
                                            <Polygon Points="2,8 2,4 10,4 12,7 22,7 22,20 2,20" Fill="White"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="Abrir Imagem" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource BotaoMenu}" Click="ButtonCadastrarBanco_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="20" Height="20" Margin="0,0,14,0">
                                        <Canvas Width="24" Height="24">
                                            <Polygon Points="6,9 18,9 12,3" Fill="White"/>
                                            <Rectangle Width="4" Height="9" Canvas.Left="10" Canvas.Top="9" Fill="White"/>
                                            <Rectangle Width="18" Height="3" Canvas.Left="3" Canvas.Top="20" Fill="White"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="Cadastrar no Banco" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource BotaoMenu}" Click="ButtonCarregarBanco_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="20" Height="20" Margin="0,0,14,0">
                                        <Canvas Width="24" Height="24">
                                            <Rectangle Width="4" Height="9" Canvas.Left="10" Canvas.Top="3" Fill="White"/>
                                            <Polygon Points="6,12 18,12 12,19" Fill="White"/>
                                            <Rectangle Width="18" Height="3" Canvas.Left="3" Canvas.Top="20" Fill="White"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="Carregar do Banco" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource BotaoMenu}" Click="ButtonSalvarImagem_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="20" Height="20" Margin="0,0,14,0">
                                        <Canvas Width="24" Height="24">
                                            <Rectangle Width="20" Height="20" Canvas.Left="2" Canvas.Top="2" Stroke="White" StrokeThickness="2"/>
                                            <Rectangle Width="10" Height="7" Canvas.Left="7" Canvas.Top="12" Fill="White"/>
                                            <Rectangle Width="6" Height="5" Canvas.Left="13" Canvas.Top="2" Fill="White"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="Salvar Imagem" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource BotaoMenu}" Click="ButtonSalvarHistograma_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="20" Height="20" Margin="0,0,14,0">
                                        <Canvas Width="24" Height="24">
                                            <Rectangle Width="3" Height="12" Canvas.Left="10.5" Canvas.Top="2" Fill="White"/>
                                            <Polygon Points="6,10 18,10 12,17" Fill="White"/>
                                            <Rectangle Width="20" Height="3" Canvas.Left="2" Canvas.Top="19" Fill="White"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="Salvar Histograma (JSON)" VerticalAlignment="Center" TextWrapping="Wrap" Width="139"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource BotaoMenu}" Click="ButtonCarregarHistograma_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="20" Height="20" Margin="0,0,14,0">
                                        <Canvas Width="24" Height="24">
                                            <Rectangle Width="3" Height="12" Canvas.Left="10.5" Canvas.Top="8" Fill="White"/>
                                            <Polygon Points="6,12 18,12 12,5" Fill="White"/>
                                            <Rectangle Width="20" Height="3" Canvas.Left="2" Canvas.Top="19" Fill="White"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="Carregar Histograma (JSON)" VerticalAlignment="Center" TextWrapping="Wrap" Width="143"/>
                                </StackPanel>
                            </Button>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Botão Sair travado na parte inferior -->
                    <Button Grid.Row="1" Style="{StaticResource BotaoMenu}" Click="ButtonSair_Click" Margin="0,10,0,15">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="20" Height="20" Margin="0,0,14,0">
                                <Canvas Width="24" Height="24">
                                    <Rectangle Width="12" Height="20" Canvas.Left="2" Canvas.Top="2" Stroke="White" StrokeThickness="2"/>
                                    <Rectangle Width="8" Height="3" Canvas.Left="14" Canvas.Top="10.5" Fill="White"/>
                                    <Polygon Points="18,7 18,17 24,12" Fill="White"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Sair" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Conteúdo principal -->
            <Border Grid.Column="1" Background="#EEF0F5">
                <ContentControl x:Name="AreaConteudo" Margin="10"/>
            </Border>
        </Grid>
    </Grid>
</Window>